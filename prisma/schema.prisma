// prisma/schema.prisma
// Comprehensive relational schema for beebly financial accountability & gamification platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalaryType {
  HOURLY
  MONTHLY
  ANNUAL
}

enum BudgetCategory {
  RENT
  GROCERIES
  DINING
  ENTERTAINMENT
  STUDENT_LOAN
  SUBSCRIPTIONS
  SHOPPING
  BUSINESS
  TRANSIT
  INVESTMENT
  MISCELLANEOUS
}

enum TransactionType {
  EXPENSE
  INCOME
  RETURN
}

enum TransactionSubType {
  STANDARD
  PHYSICAL_INVESTMENT
  MARKET_INVESTMENT
  CHARITY_GIFT
  GENEROUS_TIP
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUAL
}

enum TransitAgency {
  GO_TRANSIT
  TTC_SUBWAY
  TTC_BUS
}

enum WealthStatType {
  DISCIPLINE
  INSIGHT
  KINDNESS
  PROSPERITY
  VITALITY
  FORTITUDE
}

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  image                   String?
  salaryType              SalaryType @default(ANNUAL)
  salaryAmount            Decimal  @db.Decimal(12, 2) @default(78000.00)
  weeklyHours             Decimal  @db.Decimal(5, 2)  @default(40.00)
  totalMonthlyBudget      Decimal? @db.Decimal(12, 2)
  onboardingState         Json     @default("{\"name\":false,\"budgeting\":false,\"logging\":false,\"wealthStats\":false,\"completed\":false}")
  lastWelcomeCalendarDate String?
  googleSheetId           String?
  googleSheetName         String?
  googleSheetSyncEnabled  Boolean  @default(false)
  pushSubscription        Json?
  reducedMotion           Boolean  @default(false)
  loggingStreakDays       Int      @default(5)
  underBudgetStreakDays   Int      @default(4)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  categoryBudgets         CategoryBudget[]
  transactions            Transaction[]
  recurringTemplates      RecurringTemplate[]
  transitLogs             TransitLog[]
  transitPatterns         TransitPattern[]
  wealthStatProgress      WealthStatProgress[]
  wealthStatEvents        WealthStatEvent[]
}

model CategoryBudget {
  id           String         @id @default(cuid())
  userId       String
  category     BudgetCategory
  // Nullable monthlyLimit: null means uncapped bookkeeping-only category
  monthlyLimit Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Transaction {
  id                  String             @id @default(cuid())
  userId              String
  type                TransactionType    @default(EXPENSE)
  category            BudgetCategory
  subType             TransactionSubType @default(STANDARD)
  amount              Decimal            @db.Decimal(12, 2)
  occurredAt          DateTime           @default(now())
  isPlannedFuture     Boolean            @default(false)
  isRecurringInstance Boolean            @default(false)
  merchant            String
  notes               String             @default("")
  syncedToSheets      Boolean            @default(false)
  retainedIncome      Boolean            @default(true)
  createdAt           DateTime           @default(now())

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, category])
}

model RecurringTemplate {
  id             String             @id @default(cuid())
  userId         String
  title          String
  category       BudgetCategory
  amount         Decimal            @db.Decimal(12, 2)
  frequency      RecurringFrequency @default(MONTHLY)
  nextDueDate    DateTime
  transitRouteId String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextDueDate])
}

model TransitLog {
  id              String        @id @default(cuid())
  userId          String
  agency          TransitAgency
  originStop      String
  destinationStop String
  calculatedFare  Decimal       @db.Decimal(12, 2)
  actualFare      Decimal       @db.Decimal(12, 2)
  dayOfWeek       Int           // 0 (Sun) - 6 (Sat)
  timeSlot        String        // MORNING_RUSH, MIDDAY, EVENING_RUSH, LATE_NIGHT
  wasPredicted    Boolean       @default(false)
  oneFareApplied  Boolean       @default(false)
  occurredAt      DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, dayOfWeek, timeSlot])
}

model TransitPattern {
  id              String        @id @default(cuid())
  userId          String
  dayOfWeek       Int
  timeSlot        String
  agency          TransitAgency
  originStop      String
  destinationStop String
  standardFare    Decimal       @db.Decimal(12, 2)
  confidenceCount Int           @default(1)
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, timeSlot, agency, originStop, destinationStop])
  @@index([userId, dayOfWeek])
}

model WealthStatProgress {
  id          String         @id @default(cuid())
  userId      String
  statType    WealthStatType
  points      Int            @default(0)
  currentRank Int            @default(1)
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statType])
  @@index([userId])
}

model WealthStatEvent {
  id          String         @id @default(cuid())
  userId      String
  statType    WealthStatType
  deltaPoints Int
  reason      String
  createdAt   DateTime       @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
